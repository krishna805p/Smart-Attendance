# Replace these Aiven placeholders locally. Do not commit Backend/.env.
DB_HOST=YOUR_AIVEN_HOST
DB_PORT=YOUR_AIVEN_PORT
DB_USER=YOUR_AIVEN_USER
DB_PASSWORD=YOUR_AIVEN_PASSWORD
DB_NAME=YOUR_AIVEN_DATABASE

# Set this to Aiven's downloaded CA certificate path when required.
DB_SSL_CA=
DB_SSL_VERIFY_CERT=true
DB_SSL_VERIFY_IDENTITY=true

# Per-process Aiven pool: budget DB_POOL_SIZE * maximum backend instances against Aiven's limit.
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT_SECONDS=10
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=30
DB_SLOW_QUERY_MS=250

# Generate a private random value of at least 32 characters for signed login tokens.
AUTH_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# CORS allowlists are comma-separated origins, with no path component.
APP_ENV=development
CORS_ALLOWED_ORIGINS=https://smart-attendance-frontend-krishna80540-7402.vercel.app
CORS_PREVIEW_ORIGINS=
CORS_ALLOW_LOCAL_ORIGINS=true
# Set APP_ENV=production in AWS. This production origin is the deployed Vercel site;
# add only explicitly approved preview origins to CORS_PREVIEW_ORIGINS.
# Provision existing/new accounts out of band; application startup creates no teacher account.

# Existing GPS/geofence configuration.
CAMPUS_LATITUDE=31.2518056
CAMPUS_LONGITUDE=75.7047778
GEOFENCE_RADIUS_METERS=150

# Face verification: threshold remains provisional until independently calibrated.
FACE_MATCH_THRESHOLD=0.65
FACE_MATCH_THRESHOLD_CALIBRATED=false

# Application-level AES-256-GCM key for face templates. Generate 32 random bytes
# and URL-safe-Base64 encode them; keep the value in this ignored .env locally or
# in the deployment secret manager. Never commit a real key.
FACE_EMBEDDING_ENCRYPTION_KEY=
